# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Dashboard: Settings -> Database -> Connection string (URI)
# Format: jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://db.your-supabase-ref.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-database-password
PORT=8080
